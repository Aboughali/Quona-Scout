# Copy this file to `.env` and fill in the value. `.env` is gitignored.
# Get a token from https://console.apify.com/account/integrations
APIFY_TOKEN=

# Used by the Traction section: when an investor uploads a pitch deck or financials, the
# document is read and summarised into 2-3 traction bullets (scripts/traction/).
# Without it, uploads still store the file and say plainly that no summary could be produced.
ANTHROPIC_API_KEY=
